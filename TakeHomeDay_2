BPI 5000 CLIENTS, VLAN 8, 10.0.0.0/8, D1 A2 P2
C: 13 BITS
S: /32 - /13 = /19
I: 3rd, 32i



@D1
conf te
vlan 8
name bpi5k
exit

int vlan 8
no shutdown
ip add 10.0.32.1 255.255.224.0
exit
ip dhcp excluded-add 10.0.32.1 10.0.32.100
ip dhcp pool bpi5k
network 10.0.32.0 255.255.224.0
default-router 10.0.32.1
end

@A2
conf te
int e1/0
no shutdown
switchport access vlan 8
do show vlan brief

@P2
conf te
int e1/0
no shutdown
ip address dhcp
do bp


